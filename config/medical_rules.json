  "rules": [
    {"id":"a1c_below_5_7","category":"interpretation","test_type":"hba1c","unit":"%","if":{"lt":5.7},"then":"HbA1c dưới ngưỡng tiền đái tháo đường theo nguồn; không loại trừ bệnh.","source":{"title":"NIDDK — Diabetes Tests & Diagnosis","url":"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis"}},
    {"id":"a1c_5_7_to_below_6_5","category":"interpretation","test_type":"hba1c","unit":"%","if":{"gte":5.7,"lt":6.5},"then":"HbA1c trong khoảng tiền đái tháo đường; cần bác sĩ đánh giá.","source":{"title":"NIDDK — Diabetes Tests & Diagnosis","url":"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis"}},
    {"id":"a1c_at_least_6_5","category":"interpretation","test_type":"hba1c","unit":"%","if":{"gte":6.5},"then":"HbA1c đạt ngưỡng xét nghiệm đái tháo đường; cần bác sĩ đánh giá và xác nhận theo hoàn cảnh.","source":{"title":"NIDDK — Diabetes Tests & Diagnosis","url":"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis"}},
    {"id":"fpg_below_100","category":"interpretation","test_type":"fpg","unit":"mg/dL","if":{"lt":100},"then":"Glucose huyết tương lúc đói dưới ngưỡng tiền đái tháo đường; không loại trừ bệnh.","source":{"title":"NIDDK — Diabetes Tests & Diagnosis","url":"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis"}},
    {"id":"fpg_100_to_below_126","category":"interpretation","test_type":"fpg","unit":"mg/dL","if":{"gte":100,"lt":126},"then":"Glucose huyết tương lúc đói trong khoảng tiền đái tháo đường; cần bác sĩ đánh giá.","source":{"title":"NIDDK — Diabetes Tests & Diagnosis","url":"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis"}},
    {"id":"fpg_at_least_126","category":"interpretation","test_type":"fpg","unit":"mg/dL","if":{"gte":126},"then":"Glucose huyết tương lúc đói đạt ngưỡng xét nghiệm đái tháo đường; cần bác sĩ đánh giá và xác nhận theo hoàn cảnh.","source":{"title":"NIDDK — Diabetes Tests & Diagnosis","url":"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis"}},
    {"id":"ogtt_below_140","category":"interpretation","test_type":"ogtt_2h","unit":"mg/dL","if":{"lt":140},"then":"Glucose huyết tương OGTT 2 giờ dưới ngưỡng tiền đái tháo đường; không loại trừ bệnh.","source":{"title":"NIDDK — Diabetes Tests & Diagnosis","url":"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis"}},
    {"id":"ogtt_140_to_below_200","category":"interpretation","test_type":"ogtt_2h","unit":"mg/dL","if":{"gte":140,"lt":200},"then":"Glucose huyết tương OGTT 2 giờ trong khoảng tiền đái tháo đường; cần bác sĩ đánh giá.","source":{"title":"NIDDK — Diabetes Tests & Diagnosis","url":"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis"}},
    {"id":"ogtt_at_least_200","category":"interpretation","test_type":"ogtt_2h","unit":"mg/dL","if":{"gte":200},"then":"Glucose huyết tương OGTT 2 giờ đạt ngưỡng xét nghiệm đái tháo đường; cần bác sĩ đánh giá và xác nhận theo hoàn cảnh.","source":{"title":"NIDDK — Diabetes Tests & Diagnosis","url":"https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis"}},
    {"id":"glucose_below_54","category":"safety","test_type":"glucose","unit":"mg/dL","if":{"lt":54},"then":"Cảnh báo glucose rất thấp: cần được hỗ trợ y tế khẩn cấp, đặc biệt nếu có triệu chứng hoặc không thể tự xử trí.","source":{"title":"CDC — Low Blood Sugar (Hypoglycemia)","url":"https://www.cdc.gov/diabetes/about/low-blood-sugar-hypoglycemia.html"}},
    {"id":"glucose_54_to_below_70","category":"safety","test_type":"glucose","unit":"mg/dL","if":{"gte":54,"lt":70},"then":"Cảnh báo glucose thấp: cần xử trí kịp thời theo hướng dẫn y tế và liên hệ nhân viên y tế khi cần.","source":{"title":"CDC — Low Blood Sugar (Hypoglycemia)","url":"https://www.cdc.gov/diabetes/about/low-blood-sugar-hypoglycemia.html"}}
  ]
