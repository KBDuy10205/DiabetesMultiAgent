UNWIND [{id: "concept_glucose", name: "Glucose", kind: "measurement", aliases: ["glucose", "đường huyết"]}, {id: "concept_hba1c", name: "HbA1c", kind: "test", aliases: ["hba1c", "hemoglobin a1c"]}, {id: "concept_insulin", name: "Insulin", kind: "treatment", aliases: ["insulin"]}] AS row
