ường)_ Nguyên nhân, chẩn đoán, điều trị_files/sitecontext.min.html", raw_sha256: "b6a872aaf23a7155ffa50e0d3cce079c95191827a225730d3a308662f611304b", format: "html", quality_status: "pending", demo: false}, {id: "source_df1b47426df8d6a12a5a0b25", title: "Phân biệt chi tiết tiểu đường type 1 và type 2 theo hướng dẫn của Bộ Y tế | Vinmec", url: "https://www.vinmec.com/vie/bai-viet/phan-biet-chi-tiet-tieu-duong-type-1-va-type-2-theo-huong-dan-cua-bo-y-te-vi", source_path: "data/raw/html/Phân biệt chi tiết tiểu đường type 1 và type 2 theo hướng dẫn của Bộ Y tế _ Vinmec.html", raw_sha256: "af2236238e7743d658e265cf7c9562907db941216746edffffe54b9ad76556d8", format: "html", quality_status: "accepted", demo: false}, {id: "source_f191cfb927ee07a8d0b3b8f5", title: "null(1)", source_path: "data/raw/html/Dấu Hiệu Bệnh Tiểu Đường Sớm Cần Biết _ Vinmec _ Vinmec_files/null(1).html", raw_sha256: "97f9b10039b05e1af4a3c9b778fc72ba44cf68a376e4ec1d55f2558f16cf3e50", format: "html", quality_status: "pending", demo: false}, {id: "source_fb7113e6c29574f7fadf3def", title: "10 dấu hiệu tiểu đường thường gặp và cách nhận biết sớm", url: "https://tamanhhospital.vn/dau-hieu-tieu-duong/", source_path: "data/raw/html/10 dấu hiệu tiểu đường thường gặp và cách nhận biết sớm.html", raw_sha256: "2d3c032c5aaf2d63b338f1ee35d9662fc15b349726b0fb440bfd243b4cef1f32", published_at: "2026-08-29T10:10:07+07:00", format: "html", quality_status: "accepted", demo: false}] AS row
